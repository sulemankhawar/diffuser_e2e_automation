{
  "name": "diffuser_e2e_automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript + Cucumber BDD automation framework",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "clean": "rimraf test-results reports/html reports/allure-results reports/allure-report .features-gen tests/.features-gen allure-results",
    "bddgen": "bddgen",
    "test:bdd": "npm run clean && playwright test",
    "test": "npm run test:bdd",
    "test:headed": "cross-env HEADLESS=false npm run test:bdd",
    "test:env:staging": "cross-env TEST_ENV=staging npm run test:bdd",
    "test:env:production": "cross-env TEST_ENV=production npm run test:bdd",
    "test:tag": "cross-env BDD_TAGS=@smoke npm run test:bdd",
    "test:file": "cross-env BDD_FEATURE=features/flp-diffuser.feature npm run test:bdd",
    "report:html": "playwright show-report reports/html",
    "report:allure:generate": "allure generate allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.3.5",
    "allure-commandline": "^2.37.0",
    "allure-playwright": "^3.6.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "playwright-bdd": "^8.4.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
